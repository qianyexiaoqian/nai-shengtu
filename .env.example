# 复制为 .env 后按需修改；npm start 会自动读取
# API、图片链接、后台都在这一个端口上；只走反代时可把 HOST 设为 127.0.0.1
PORT=3000
HOST=0.0.0.0
# 数据目录（SQLite 数据库 relay.db 放在这里）
DATA_DIR=data
# 后台密码：设置后每次启动都重置成它；留空则首次启动随机生成并打印到控制台，之后可在后台修改
ADMIN_PASSWORD=
# 上游超时（毫秒），含排队时间
UPSTREAM_TIMEOUT_MS=300000

# 以下只作为首次启动的初值，之后以后台里的为准
# 上游秘钥（多把用逗号分隔）和它们的接口地址；首次启动导入“上游秘钥”页，之后在后台管理，可以再加别的上游
# NovelAI 官方：UPSTREAM_KEY 填 pst- 开头的持久令牌，UPSTREAM_BASE 留空
# OpenAI 兼容的 NAI 生图站：UPSTREAM_BASE 填到 /v1，比如 https://example.com/v1，UPSTREAM_KEY 填它给的 sk-
UPSTREAM_BASE=
UPSTREAM_KEY=
PUBLIC_BASE_URL=
